// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// Same scale as mango's monitor-laptop.conf.
output "eDP-1" {
    mode "1920x1200@60.001"
    scale 1.2
    position x=0 y=0
}

// Dummy HDMI plug — streamed to iPad Pro 13" (2024) via Sunshine/Moonlight.
// x must equal eDP-1's logical width (1920 / 1.2 = 1600) so the outputs touch.
// niri keeps scale as f64, so unlike mango (x:1599) this is exactly 1600.
// 1.75 makes text on the iPad the same physical size as on the laptop panel;
// Sunshine still captures the full 2560x1600.
output "HDMI-A-1" {
    mode "2560x1600@59.972"
    scale 1.75
    position x=1600 y=0
}

// ────────────── Named Workspaces ──────────────
// Index on eDP-1 = mango tag: Mod+1/2/3 = main/net/notes.
workspace "main" { open-on-output "eDP-1"; }
workspace "net" { open-on-output "eDP-1"; }
workspace "notes" { open-on-output "eDP-1"; }
