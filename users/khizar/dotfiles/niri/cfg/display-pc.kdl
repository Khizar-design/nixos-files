// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// Left monitor (DP-2) — Microstep MAG 276CXF
// Supports up to 280Hz; bump mode to 240.000 or 280.003 if desired.
output "DP-2" {
    mode "1920x1080@280.003"
    scale 1.0
    position x=0 y=0
}

// Right monitor (DP-1) — Microstep MAG 276CXF
output "DP-1" {
    mode "1920x1080@280.003"
    scale 1.0
    position x=1920 y=0
}

// ────────────── Named Workspaces ──────────────
// niri workspaces are per-output, like mango's tags. Declaration order is the
// index on that output, so Mod+1..3 on DP-2 = main/net/notes and Mod+1..2 on
// DP-1 = chat/mail — the same slots mango's rules.conf uses.
workspace "main" { open-on-output "DP-2"; }
workspace "net" { open-on-output "DP-2"; }
workspace "notes" { open-on-output "DP-2"; }

// DP-1 is the Equibop screen: equibop on 1, proton mail parked on 2.
workspace "chat" { open-on-output "DP-1"; }
workspace "mail" { open-on-output "DP-1"; }
