// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup
// Mirrors mango/autostart-pc.sh. No xwayland-satellite here: niri spawns it
// on demand and sets DISPLAY itself.

    spawn-at-startup "noctalia-shell"
    spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
    spawn-at-startup "equibop"
    spawn-at-startup "proton-mail"
    // DP-1 is the side (Equibop) screen; see dotfiles/niri/zen-placer.sh.
    spawn-at-startup "niri-zen-placer" "DP-1"
